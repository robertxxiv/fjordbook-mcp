{
    "name": "fjordbook-mcp",
    "version": "1.1.0",
    "description": "MCP server for the Fiken accounting API",
    "type": "module",
    "main": "build/index.js",
    "bin": {
        "fjordbook-mcp": "build/index.js"
    },
    "files": [
        "build"
    ],
    "scripts": {
        "build": "tsc",
        "start": "node build/index.js",
        "dev": "tsx src/index.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "smoke": "node scripts/smoke.mjs",
        "changeset": "changeset",
        "version": "changeset version",
        "release": "pnpm build && changeset publish",
        "prepare": "husky"
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/robertxxiv/fjordbook-mcp.git"
    },
    "homepage": "https://github.com/robertxxiv/fjordbook-mcp",
    "bugs": {
        "url": "https://github.com/robertxxiv/fjordbook-mcp/issues"
    },
    "license": "MIT",
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.11.0",
        "zod": "^3.24.0"
    },
    "devDependencies": {
        "@changesets/cli": "^2.30.0",
        "@types/node": "^22.0.0",
        "@vitest/coverage-v8": "^3.0.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "^3.8.1",
        "tsx": "^4.19.0",
        "typescript": "^5.8.0",
        "vitest": "^3.0.0",
        "yaml": "^2.9.1"
    },
    "engines": {
        "node": ">=18.17"
    },
    "lint-staged": {
        "*": "prettier --write --ignore-unknown"
    }
}
